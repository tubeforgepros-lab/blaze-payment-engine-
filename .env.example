# ---- Runtime ----
BLAZE_ENV=production
BLAZE_DB_PATH=/var/data/blaze_ledgers.db
BLAZE_SEED_BALANCE=0.00
BLAZE_ALLOWED_ORIGINS=https://your-frontend.example.com

# Shared secret required in the X-API-Key header for payout requests.
# Leave unset ONLY in local development.
BLAZE_API_KEY=

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- Plaid (pre-flight balance verification is fail-closed) ----
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Local-only escape hatch. NEVER set to true in production.
BLAZE_ALLOW_UNVERIFIED_PLAID=false

# ---- Celery / Redis (optional; falls back to FastAPI BackgroundTasks) ----
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
